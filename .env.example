# Security Configuration
# Copy this file to .env and fill in your actual values

# Development
VITE_NODE_ENV=development

# API Configuration
VITE_API_BASE_URL=https://mediniquizeapplicationbackend.onrender.com/api/v1
VITE_SOCKET_URL=https://mediniquizeapplicationbackend.onrender.com

# Security Keys (IMPORTANT: Generate secure random keys for production)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VITE_ENCRYPTION_KEY=your_secure_encryption_key_here
VITE_JWT_SECRET=your_jwt_secret_key_here

# CSRF Protection
VITE_CSRF_ENABLED=true

# Session Configuration
VITE_SESSION_TIMEOUT=3600000
VITE_IDLE_TIMEOUT=1800000

# Rate Limiting
VITE_RATE_LIMIT_ENABLED=true
VITE_MAX_REQUESTS_PER_MINUTE=60

# Feature Flags
VITE_ENABLE_AUDIT_LOGGING=true
VITE_ENABLE_SECURITY_HEADERS=true

# CORS Configuration (if needed)
VITE_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com